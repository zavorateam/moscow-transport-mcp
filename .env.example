# .env.example

# ===== Server =====
# Стандартные порт и хост сервера
HOST=
PORT=

STOPS_GEOJSON_PATH=bus_stops_all.geojson

# ===== Yandex.Maps =====
# Получите значения из cookie-сессии yandex.ru/maps
YANDEX_CSRF_TOKEN=
YANDEX_SESSION_ID=
YANDEX_S_VEHICLES=
YANDEX_S_STOPS=
YANDEX_COOKIE=

# ===== РНИС МО =====
RNIS_BASE_URL=https://portal.rnis.mosreg.ru/busajax/request
RNIS_CACHE_TTL_SECONDS=900
RNIS_REQUEST_INTERVAL=0.5

# ===== МосТранспорт API =====
MOSCOW_STOP_V2_URL=https://api.moscowapp.mos.ru/v8.2/stop_v2
MOSCOW_QR_STOP_URL=https://api.moscowapp.mos.ru/v8.2/qr-stop

# ===== Дефолты алгоритмов оркестратора =====
# Значения по умолчанию (центр Москвы), переопределяются аргументами запроса
DEFAULT_SEARCH_LAT= # широта стандартная
DEFAULT_SEARCH_LON= # долгота стандартная
DEFAULT_SEARCH_RADIUS_KM=
DEFAULT_AVERAGE_SPEED_KMH=
RECONCILIATION_THRESHOLD_SECONDS=180